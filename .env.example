# Fitbit Realtime Dashboard - Environment Variables
# Copy this file to .env and fill in your values

# ──────────────────────────────────────────
# Fitbit OAuth2 App Credentials
# Get these from: https://dev.fitbit.com/apps/new
# ──────────────────────────────────────────
FITBIT_CLIENT_ID=YOUR_CLIENT_ID_HERE
FITBIT_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# This MUST match exactly what you set in the Fitbit app settings
FITBIT_REDIRECT_URI=http://localhost:3000/auth/callback

# ──────────────────────────────────────────
# Server Config
# ──────────────────────────────────────────
PORT=3000
SESSION_SECRET=super-secret-session-key-change-this-in-production

# ──────────────────────────────────────────
# Polling interval in seconds (how often to refresh data)
# Fitbit API rate limit: 150 requests/hour per user
# ──────────────────────────────────────────
POLL_INTERVAL_SECONDS=30
